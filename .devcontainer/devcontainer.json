{
  "name": "helen-reads-music (sandboxed)",
  "initializeCommand": "bash .devcontainer/run.sh --build-only",
  "image": "helen-reads-music-devcontainer",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=helen-reads-music-claude-config,target=/state/claude-config,type=volume",
    "source=helen-reads-music-bundle-cache,target=/state/bundle,type=volume"
  ],
  "remoteEnv": {
    "AGENT_GH_TOKEN": "${localEnv:AGENT_GH_TOKEN}"
  },
  "updateRemoteUserUID": false
}
